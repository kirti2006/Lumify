# Application Settings
APP_NAME="Lumify AI Microservice MS-2"
APP_VERSION="1.0.0"
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8001

# Database
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-lively-water-123456.us-east-2.aws.neon.tech/neondb?ssl=require
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://default:password@upstash-url:6379/0
REDIS_MAX_CONNECTIONS=50

# LLM Provider
LLM_PROVIDER=groq

# Groq (free tier — openai/gpt-oss-120b)
GROQ_API_KEY=your-groq-api-key
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
GROQ_DEFAULT_TEMPERATURE=0.7
GROQ_DEFAULT_TIMEOUT=120
GROQ_MAX_RETRIES=3

# Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERNAL_API_KEY=internal-api-key-change-in-production

# Celery
CELERY_BROKER_URL=redis://default:password@upstash-url:6379/1
CELERY_RESULT_BACKEND=redis://default:password@upstash-url:6379/2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=["*"]
