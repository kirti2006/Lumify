# =========================================
# GLOBAL LUMIFY ENVIRONMENT TEMPLATE
# =========================================
# This file serves as a reference. You should create specific 
# .env or .env.local files inside frontend/, backend/ms1/, and backend/ms2/.

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=Lumify

# --- MS-1 Gateway (backend/ms1/.env) ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://neondb_owner:password@ep-lively-water-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_ACCESS_SECRET=your-32-char-secret-for-access-token
JWT_REFRESH_SECRET=your-32-char-secret-for-refresh-token
CLOUDINARY_URL=cloudinary://my_key:my_secret@my_cloud_name
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=internal-api-key-change-in-production
RESEND_API_KEY=re_your_api_key_here
CORS_ORIGIN=*
LOG_LEVEL=info

# --- MS-2 AI Backend (backend/ms2/.env) ---
APP_NAME="Lumify AI Microservice MS-2"
HOST=0.0.0.0
PORT=8001
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-lively-water-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
JWT_SECRET_KEY=your-32-char-secret-for-access-token
INTERNAL_API_KEY=internal-api-key-change-in-production
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CORS_ORIGINS=["*"]
